<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="de.blinkt.openvpn">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <activity android:name=".VPNHelper"
            android:exported="true"
            tools:ignore="Instantiatable" />
        <!-- Diagnostic-only, temporary: see CrashReportActivity.java -->
        <activity android:name=".CrashReportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light" />
        <!-- Begin Activity by ics-openvpn -->
        <service
            android:name=".core.OpenVPNService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="vpn"/>
        </service>

        <activity
            android:name=".LaunchVPN"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/vpn_launch_title"
            android:theme="@android:style/Theme.DeviceDefault.Light.Panel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DisconnectVPNActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true"
            android:taskAffinity=".DisconnectVPN"
            android:theme="@style/blinkt.dialog" />

        <!-- Remaining official components, bulk-copied as .java files during
             the official-source replacement but never previously declared
             here (this manifest was nizwar's untouched original, which
             predates all of these classes). Declared here to match
             official's own manifest 1:1 for these (minus the :openvpn
             multi-process attribute, which this fork doesn't use), after
             the keepVPNAlive JobService crash showed that a bulk-copied
             class with no manifest entry crashes the moment something
             actually tries to use it. -->
        <activity
            android:name=".activities.DisconnectVPN"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".DisconnectVPN"
            android:theme="@style/blinkt.dialog" />

        <service android:name=".core.keepVPNAlive"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE"/>

        <!-- Missed in the previous pass: StatusListener.init() (now called
             from OpenVPNService.onCreate() to forward VpnStatus's log,
             openvpn's own output included, to Logcat) binds to this
             service. Undeclared, that bindService() call just silently
             failed, so the log-forwarding fix never actually activated. -->
        <service android:name=".core.OpenVPNStatusService"
            android:exported="false" />

        <service
            android:name=".api.ExternalOpenVPNService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="de.blinkt.openvpn.api.IOpenVPNAPIService" />
            </intent-filter>
        </service>

        <activity android:name=".api.GrantPermissionsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".api.ConfirmDialog"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".api.RemoteAction"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=".LaunchVPN"
            android:theme="@style/blinkt.dialog"
            android:noHistory="true" />
        <activity-alias
            android:name=".api.ConnectVPN"
            android:exported="true"
            android:targetActivity=".api.RemoteAction" />
        <activity-alias
            android:name=".api.DisconnectVPN"
            android:exported="true"
            android:targetActivity=".api.RemoteAction" />
        <activity-alias
            android:name=".api.PauseVPN"
            android:exported="true"
            android:targetActivity=".api.RemoteAction" />
        <activity-alias
            android:name=".api.ResumeVPN"
            android:exported="true"
            android:targetActivity=".api.RemoteAction" />
        <activity-alias
            android:name=".api.SetDefaultVPN"
            android:exported="true"
            android:targetActivity=".api.RemoteAction" />

        <receiver android:name=".OnBootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
